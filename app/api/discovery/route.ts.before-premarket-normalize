import { NextResponse } from "next/server";
import {
  scanDiscoveryUniverse,
  type DiscoveryScanResult,
} from "@/libs/market/discoveryScanner";
import type { UniverseCategory } from "@/libs/market/universe";
import { getTradingViewPremarketCandidates } from "@/libs/market/tradingViewScreener";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

const DEFAULT_LIMIT = 75;
const MAX_LIMIT = 250;
const DEFAULT_CONCURRENCY = 1;
const MAX_CONCURRENCY = 8;
const DEFAULT_MINIMUM_SCORE = 45;

type CachedDiscovery = {
  timestamp: number;
  data: DiscoveryScanResult;
};

const discoveryCache = new Map<string, CachedDiscovery>();
const pendingScans = new Map<string, Promise<DiscoveryScanResult>>();

const CACHE_TIME_MS = 60_000;

const VALID_CATEGORIES = new Set<UniverseCategory>([
  "market-etfs",
  "sector-etfs",
  "mega-cap",
  "semiconductors",
  "ai-infrastructure",
  "software-cloud",
  "cybersecurity",
  "financials",
  "energy",
  "industrials",
  "healthcare",
  "consumer",
  "communications",
  "materials",
  "utilities",
  "real-estate",
  "high-beta",
  "defensive",
]);

function parseInteger(
  value: string | null,
  fallback: number,
  minimum: number,
  maximum: number,
): number {
  const parsed = Number.parseInt(value ?? "", 10);

  if (!Number.isFinite(parsed)) {
    return fallback;
  }

  return Math.min(Math.max(parsed, minimum), maximum);
}

function parseCategory(value: string | null): UniverseCategory | undefined {
  const category = value?.trim() as UniverseCategory | undefined;

  if (!category || !VALID_CATEGORIES.has(category)) {
    return undefined;
  }

  return category;
}

function buildCacheKey(input: {
  category?: UniverseCategory;
  limit: number;
  concurrency: number;
  minimumScore: number;
}): string {
  return [
    input.category ?? "all",
    input.limit,
    input.concurrency,
    input.minimumScore,
  ].join(":");
}

async function runDiscoveryScan(input: {
  category?: UniverseCategory;
  limit: number;
  concurrency: number;
  minimumScore: number;
  forceRefresh: boolean;
}): Promise<DiscoveryScanResult> {
  const cacheKey = buildCacheKey(input);

  if (!input.forceRefresh) {
    const cached = discoveryCache.get(cacheKey);

    if (cached && Date.now() - cached.timestamp < CACHE_TIME_MS) {
      return cached.data;
    }
  }

  const existing = pendingScans.get(cacheKey);

  if (existing) {
    return existing;
  }

  const pending = scanDiscoveryUniverse({
    category: input.category,
    limit: input.limit,
    concurrency: input.concurrency,
    minimumScore: input.minimumScore,
    forceRefresh: input.forceRefresh,
  })
    .then((data) => {
      discoveryCache.set(cacheKey, {
        timestamp: Date.now(),
        data,
      });

      return data;
    })
    .finally(() => {
      pendingScans.delete(cacheKey);
    });

  pendingScans.set(cacheKey, pending);

  return pending;
}

export async function GET(request: Request) {
  const requestUrl = new URL(request.url);

  const mode =
    requestUrl.searchParams.get("mode")?.trim().toLowerCase();

  /*
   * PRE-MARKET DISCOVERY
   *
   * TradingView performs the broad extended-hours scan.
   * This path does NOT run the normal regular-market
   * discovery engine.
   */
  if (mode === "premarket") {
    const premarketLimit = parseInteger(
      requestUrl.searchParams.get("limit"),
      20,
      1,
      50,
    );

    try {
      const candidates =
        await getTradingViewPremarketCandidates(
          premarketLimit,
        );

      const normalizedCandidates = candidates.map(
        (candidate) => {
          const absoluteGap =
            Math.abs(candidate.premarketGapPercent);

          let score = 0;
          const reasons: string[] = [];

          /*
           * PRE-MARKET VOLUME
           */
          if (candidate.premarketVolume >= 1_000_000) {
            score += 40;
            reasons.push("Pre-market volume is above 1M");
          } else if (candidate.premarketVolume >= 500_000) {
            score += 32;
            reasons.push("Strong pre-market volume");
          } else if (candidate.premarketVolume >= 250_000) {
            score += 24;
            reasons.push("Good pre-market participation");
          } else {
            score += 15;
            reasons.push("Pre-market activity detected");
          }

          /*
           * GAP QUALITY
           *
           * We prefer meaningful movement without
           * rewarding stocks that are already too extended.
           */
          if (absoluteGap >= 1 && absoluteGap <= 4) {
            score += 35;
            reasons.push("Pre-market gap is in the preferred range");
          } else if (absoluteGap > 4 && absoluteGap <= 6) {
            score += 25;
            reasons.push("Strong pre-market gap");
          } else if (absoluteGap > 6) {
            score += 12;
            reasons.push("Large pre-market gap — avoid chasing");
          } else {
            score += 20;
            reasons.push("Developing pre-market gap");
          }

          /*
           * LIQUID / ESTABLISHED COMPANY FILTER
           */
          if (candidate.marketCap >= 10_000_000_000) {
            score += 15;
            reasons.push("Large-cap liquidity");
          } else if (candidate.marketCap >= 1_000_000_000) {
            score += 10;
            reasons.push("Meets OptionPilot market-cap requirement");
          }

          /*
           * PRE-MARKET RANGE
           */
          const range =
            candidate.premarketHigh -
            candidate.premarketLow;

          if (
            range > 0 &&
            candidate.premarketPrice > 0
          ) {
            const rangePercent =
              (range / candidate.premarketPrice) * 100;

            if (rangePercent >= 0.5) {
              score += 10;
              reasons.push("Pre-market range is active");
            }
          }

          score = Math.max(
            0,
            Math.min(100, Math.round(score)),
          );

          return {
            symbol: candidate.symbol,

            price: candidate.premarketPrice,

            change:
              candidate.premarketPrice -
              candidate.regularPrice,

            percentChange:
              candidate.premarketGapPercent,

            volume:
              candidate.premarketVolume,

            /*
             * Regular-market average volume is not
             * available in this pre-market query.
             */
            averageVolume: 0,

            /*
             * Do not fake regular-session RVOL.
             */
            relativeVolume: 0,

            direction:
              candidate.premarketGapPercent >= 0.5
                ? "CALLS"
                : candidate.premarketGapPercent <= -0.5
                  ? "PUTS"
                  : "WAIT",

            score,

            reasons,

            description:
              candidate.description,

            exchange:
              candidate.exchange,

            regularPrice:
              candidate.regularPrice,

            premarketPrice:
              candidate.premarketPrice,

            premarketChangePercent:
              candidate.premarketChangePercent,

            premarketGapPercent:
              candidate.premarketGapPercent,

            premarketVolume:
              candidate.premarketVolume,

            premarketHigh:
              candidate.premarketHigh,

            premarketLow:
              candidate.premarketLow,

            marketCap:
              candidate.marketCap,
          };
        },
      );

      const rankedCandidates =
        [...normalizedCandidates].sort(
          (first, second) =>
            second.score - first.score,
        );

      return NextResponse.json({
        success: true,
        mode: "premarket",
        category: "all",
        source: "tradingview",
        cached: false,
        updatedAt: new Date().toISOString(),
        scanned: rankedCandidates.length,
        qualified: rankedCandidates.length,
        failed: 0,
        durationMs: 0,

        candidates:
          rankedCandidates,

        topOpportunities:
          rankedCandidates.slice(0, 20),

        topGainers:
          [...rankedCandidates]
            .sort(
              (first, second) =>
                second.premarketGapPercent -
                first.premarketGapPercent,
            )
            .slice(0, 20),

        topLosers:
          [...rankedCandidates]
            .sort(
              (first, second) =>
                first.premarketGapPercent -
                second.premarketGapPercent,
            )
            .slice(0, 20),

        relativeVolume:
          [...rankedCandidates]
            .sort(
              (first, second) =>
                second.premarketVolume -
                first.premarketVolume,
            )
            .slice(0, 20),
      });
    } catch (error) {
      console.error(
        "Pre-market discovery scan failed:",
        error,
      );

      return NextResponse.json(
        {
          success: false,
          mode: "premarket",
          source: "tradingview",
          error:
            error instanceof Error
              ? error.message
              : "Unable to complete the pre-market scan.",
        },
        {
          status: 502,
        },
      );
    }
  }

  const category = parseCategory(requestUrl.searchParams.get("category"));

  const limit = parseInteger(
    requestUrl.searchParams.get("limit"),
    DEFAULT_LIMIT,
    1,
    MAX_LIMIT,
  );

  const concurrency = parseInteger(
    requestUrl.searchParams.get("concurrency"),
    DEFAULT_CONCURRENCY,
    1,
    MAX_CONCURRENCY,
  );

  const minimumScore = parseInteger(
    requestUrl.searchParams.get("minimumScore"),
    DEFAULT_MINIMUM_SCORE,
    0,
    100,
  );

  const forceRefresh = requestUrl.searchParams.get("refresh") === "1";

  try {
    const result = await runDiscoveryScan({
      category,
      limit,
      concurrency,
      minimumScore,
      forceRefresh,
    });

    return NextResponse.json({
      success: true,
      category: category ?? "all",
      cached: !forceRefresh,
      updatedAt: result.completedAt,
      ...result,
    });
  } catch (error) {
    console.error("Discovery scan failed:", error);

    return NextResponse.json(
      {
        success: false,
        error:
          error instanceof Error
            ? error.message
            : "Unable to complete the discovery scan.",
        category: category ?? "all",
        limit,
      },
      {
        status: 502,
      },
    );
  }
}
