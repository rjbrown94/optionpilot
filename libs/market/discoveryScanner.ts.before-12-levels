export type DiscoveryDirection = "CALLS" | "PUTS" | "WAIT";

export type DiscoveryCandidate = {
  symbol: string;
  price: number;
  change: number;
  percentChange: number;
  volume: number;
  averageVolume: number;
  relativeVolume: number;
  direction: DiscoveryDirection;
  score: number;
  reasons: string[];

  support?: number | null;
  resistance?: number | null;

  distanceToSupportPercent?: number | null;
  distanceToResistancePercent?: number | null;

  nearSupport?: boolean;
  nearResistance?: boolean;

  trend?: string | null;
  trendConfidence?: number | null;

  levelSetup?: DiscoveryLevelSetup | null;

  bullishBreakout?: boolean;
  bearishBreakdown?: boolean;
};

export type DiscoveryScanResult = {
  scanned: number;
  qualified: number;
  failed: number;
  startedAt: string;
  completedAt: string;
  durationMs: number;
  candidates: DiscoveryCandidate[];
  topOpportunities: DiscoveryCandidate[];
  topGainers: DiscoveryCandidate[];
  topLosers: DiscoveryCandidate[];
  relativeVolume: DiscoveryCandidate[];
  failures: Array<{
    symbol: string;
    error: string;
  }>;

  source?: "tradingview" | "optionpilot-fallback";
};

type ScanOptions = {
  category?: UniverseCategory;
  limit?: number;
  concurrency?: number;
  minimumScore?: number;
  forceRefresh?: boolean;
};

function clamp(
  value: number,
  minimum: number,
  maximum: number,
): number {
  return Math.max(minimum, Math.min(value, maximum));
}

function round(value: number, digits = 2): number {
  const multiplier = 10 ** digits;

  return Math.round(value * multiplier) / multiplier;
}

function getDirectionFromPercentChange(
  percentChange: number,
): DiscoveryDirection {
  if (percentChange >= 1) {
    return "CALLS";
  }

  if (percentChange <= -1) {
    return "PUTS";
  }

  return "WAIT";
}

function getDirection(
  quote: MarketQuote,
): DiscoveryDirection {
  return getDirectionFromPercentChange(
    quote.percentChange,
  );
}

function scoreMarketData(input: {
  price: number;
  percentChange: number;
  volume: number;
  averageVolume: number;
  relativeVolume: number;
  rsi?: number | null;
}): {
  score: number;
  reasons: string[];
} {
  let score = 0;

  const reasons: string[] = [];

  const absoluteMove =
    Math.abs(input.percentChange);

  /*
   * Price movement.
   *
   * For now this preserves your existing
   * Discovery scoring behavior.
   *
   * Support/resistance proximity will become
   * a larger part of the score in the next upgrade.
   */
  if (absoluteMove >= 5) {
    score += 35;
    reasons.push("Price moved at least 5%");
  } else if (absoluteMove >= 3) {
    score += 30;
    reasons.push("Price moved at least 3%");
  } else if (absoluteMove >= 2) {
    score += 24;
    reasons.push("Price moved at least 2%");
  } else if (absoluteMove >= 1) {
    score += 16;
    reasons.push("Price moved at least 1%");
  } else {
    score += 6;
  }

  /*
   * Relative volume.
   */
  if (input.relativeVolume >= 3) {
    score += 35;
    reasons.push("Relative volume is at least 3x");
  } else if (input.relativeVolume >= 2) {
    score += 30;
    reasons.push("Relative volume is at least 2x");
  } else if (input.relativeVolume >= 1.5) {
    score += 24;
    reasons.push("Relative volume is at least 1.5x");
  } else if (input.relativeVolume >= 1.2) {
    score += 16;
    reasons.push("Relative volume is above average");
  } else {
    score += 5;
  }

  /*
   * Preferred trading price.
   */
  if (
    input.price >= 10 &&
    input.price <= 500
  ) {
    score += 10;

    reasons.push(
      "Price is inside the preferred trading range",
    );
  } else if (input.price > 0) {
    score += 5;
  }

  /*
   * Liquidity.
   */
  if (input.averageVolume >= 5_000_000) {
    score += 15;

    reasons.push("Very strong average liquidity");
  } else if (
    input.averageVolume >= 1_000_000
  ) {
    score += 12;

    reasons.push("Strong average liquidity");
  } else if (
    input.averageVolume >= 250_000
  ) {
    score += 8;

    reasons.push("Acceptable average liquidity");
  }

  if (input.volume >= 1_000_000) {
    score += 5;

    reasons.push("Strong current volume");
  }

  /*
   * RSI context from TradingView.
   *
   * We do NOT use RSI alone to generate
   * CALL or PUT direction.
   */
  if (
    input.rsi !== null &&
    input.rsi !== undefined &&
    Number.isFinite(input.rsi)
  ) {
    if (
      input.rsi >= 40 &&
      input.rsi <= 70
    ) {
      reasons.push(
        `RSI ${input.rsi.toFixed(1)} is in a tradable momentum range`,
      );
    } else if (input.rsi > 70) {
      reasons.push(
        `RSI ${input.rsi.toFixed(1)} is extended`,
      );
    } else if (input.rsi < 30) {
      reasons.push(
        `RSI ${input.rsi.toFixed(1)} is oversold`,
      );
    }
  }

  return {
    score: clamp(
      Math.round(score),
      0,
      100,
    ),

    reasons,
  };
}

function scoreQuote(
  quote: MarketQuote,
): {
  score: number;
  reasons: string[];
} {
  return scoreMarketData({
    price: quote.price,
    percentChange: quote.percentChange,
    volume: quote.volume,
    averageVolume: quote.averageVolume,
    relativeVolume: quote.relativeVolume,
  });
}

function toCandidate(
  quote: MarketQuote,
): DiscoveryCandidate {
  const scoring = scoreQuote(quote);

  return {
    symbol: quote.symbol,

    price: round(quote.price),

    change: round(quote.change),

    percentChange:
      round(quote.percentChange),

    volume:
      Math.round(quote.volume),

    averageVolume:
      Math.round(quote.averageVolume),

    relativeVolume:
      round(quote.relativeVolume),

    direction:
      getDirection(quote),

    score:
      scoring.score,

    reasons:
      scoring.reasons,
  };
}

function tradingViewToCandidate(
  item: TradingViewCandidate,
): DiscoveryCandidate {
  /*
   * TradingView gives us current volume
   * and relative volume.
   *
   * Approximate the underlying average volume:
   *
   * current volume / relative volume
   */
  const averageVolume =
    item.relativeVolume > 0
      ? item.volume /
        item.relativeVolume
      : 0;

  const scoring = scoreMarketData({
    price: item.price,
    percentChange:
      item.percentChange,
    volume: item.volume,
    averageVolume,
    relativeVolume:
      item.relativeVolume,
    rsi: item.rsi,
  });

  return {
    symbol:
      item.symbol,

    price:
      round(item.price),

    /*
     * TradingView returned % change,
     * but not previous close in this query.
     *
     * Keep dollar change at 0 for now rather
     * than inventing a number.
     */
    change: 0,

    percentChange:
      round(item.percentChange),

    volume:
      Math.round(item.volume),

    averageVolume:
      Math.round(averageVolume),

    relativeVolume:
      round(item.relativeVolume),

    direction:
      getDirectionFromPercentChange(
        item.percentChange,
      ),

    score:
      scoring.score,

    reasons: [
      `TradingView market-wide screener`,
      ...scoring.reasons,
    ],
  };
}

function getLevelScoreAdjustment(
  levels: DiscoveryLevelResult,
): {
  points: number;
  reasons: string[];
} {
  let points = 0;

  const reasons: string[] = [];

  if (levels.setup === "NEAR_SUPPORT") {
    points += 30;

    reasons.push(
      `Near confirmed support${
        levels.distanceToSupportPercent !== null
          ? ` (${levels.distanceToSupportPercent.toFixed(2)}% away)`
          : ""
      }`,
    );

    if (levels.trend === "UPTREND") {
      points += 10;

      reasons.push(
        "Support is aligned with the broader uptrend",
      );
    }
  }

  if (levels.setup === "NEAR_RESISTANCE") {
    points += 30;

    reasons.push(
      `Near confirmed resistance${
        levels.distanceToResistancePercent !== null
          ? ` (${levels.distanceToResistancePercent.toFixed(2)}% away)`
          : ""
      }`,
    );

    if (levels.trend === "DOWNTREND") {
      points += 10;

      reasons.push(
        "Resistance is aligned with the broader downtrend",
      );
    }
  }

  if (levels.setup === "BREAKOUT") {
    const distance =
      levels.distanceToResistancePercent ??
      Number.POSITIVE_INFINITY;

    if (distance <= 0.75) {
      points += 26;

      reasons.push(
        `Fresh resistance breakout (${distance.toFixed(2)}% from level)`,
      );
    } else if (distance <= 1.5) {
      points += 16;

      reasons.push(
        `Recent resistance breakout (${distance.toFixed(2)}% from level)`,
      );
    } else if (distance <= 3) {
      points += 4;

      reasons.push(
        `Breakout already extended ${distance.toFixed(2)}% above resistance`,
      );
    } else {
      points -= 20;

      reasons.push(
        `Breakout is too extended — ${distance.toFixed(2)}% above resistance`,
      );
    }
  }

  if (levels.setup === "BREAKDOWN") {
    const distance =
      levels.distanceToSupportPercent ??
      Number.POSITIVE_INFINITY;

    if (distance <= 0.75) {
      points += 26;

      reasons.push(
        `Fresh support breakdown (${distance.toFixed(2)}% from level)`,
      );
    } else if (distance <= 1.5) {
      points += 16;

      reasons.push(
        `Recent support breakdown (${distance.toFixed(2)}% from level)`,
      );
    } else if (distance <= 3) {
      points += 4;

      reasons.push(
        `Breakdown already extended ${distance.toFixed(2)}% below support`,
      );
    } else {
      points -= 20;

      reasons.push(
        `Breakdown is too extended — ${distance.toFixed(2)}% below support`,
      );
    }
  }

  if (levels.setup === "NO_KEY_LEVEL") {
    points -= 12;

    reasons.push(
      "Price is not currently near a confirmed key level",
    );
  }

  return {
    points,
    reasons,
  };
}

function getChasePenalty(
  percentChange: number,
): {
  points: number;
  reason: string | null;
} {
  const move = Math.abs(percentChange);

  if (move >= 20) {
    return {
      points: -35,
      reason:
        "Very extended move already occurred — avoid chasing",
    };
  }

  if (move >= 12) {
    return {
      points: -25,
      reason:
        "Stock is already highly extended",
    };
  }

  if (move >= 8) {
    return {
      points: -15,
      reason:
        "Large move already occurred",
    };
  }

  if (move >= 5) {
    return {
      points: -6,
      reason:
        "Moderate extension — wait for a clean level setup",
    };
  }

  return {
    points: 0,
    reason: null,
  };
}

function enrichCandidateWithLevels(
  candidate: DiscoveryCandidate,
  levels: DiscoveryLevelResult,
): DiscoveryCandidate {
  const levelAdjustment =
    getLevelScoreAdjustment(levels);

  const chasePenalty =
    getChasePenalty(candidate.percentChange);

  let score =
    candidate.score +
    levelAdjustment.points +
    chasePenalty.points;

  score = clamp(
    Math.round(score),
    0,
    100,
  );

  const reasons = [
    ...levelAdjustment.reasons,
    ...(chasePenalty.reason
      ? [chasePenalty.reason]
      : []),
    ...candidate.reasons,
  ];

  return {
    ...candidate,

    score,

    reasons,

    support:
      levels.support,

    resistance:
      levels.resistance,

    distanceToSupportPercent:
      levels.distanceToSupportPercent,

    distanceToResistancePercent:
      levels.distanceToResistancePercent,

    nearSupport:
      levels.nearSupport,

    nearResistance:
      levels.nearResistance,

    trend:
      levels.trend,

    trendConfidence:
      levels.trendConfidence,

    levelSetup:
      levels.setup,

    bullishBreakout:
      levels.bullishBreakout,

    bearishBreakdown:
      levels.bearishBreakdown,
  };
}

function sleep(
  milliseconds: number,
): Promise<void> {
  return new Promise((resolve) =>
    setTimeout(resolve, milliseconds),
  );
}

async function enrichTradingViewLevels(
  candidates: DiscoveryCandidate[],
): Promise<DiscoveryCandidate[]> {
  /*
   * TradingView already searched the broad market.
   *
   * Only run the heavier daily support/resistance
   * calculation on a small shortlist.
   */
  const LEVEL_ANALYSIS_LIMIT = 6;

  /*
   * We prefer stocks that have NOT already made
   * enormous moves because the goal is to catch
   * developing setups before chasing them.
   */
  const shortlist = [...candidates]
    .sort((first, second) => {
      const firstMove =
        Math.abs(first.percentChange);

      const secondMove =
        Math.abs(second.percentChange);

      const firstExtended =
        firstMove >= 10 ? 1 : 0;

      const secondExtended =
        secondMove >= 10 ? 1 : 0;

      if (firstExtended !== secondExtended) {
        return firstExtended - secondExtended;
      }

      return (
        second.relativeVolume -
        first.relativeVolume
      );
    })
    .slice(0, LEVEL_ANALYSIS_LIMIT);

  const enrichedBySymbol =
    new Map<string, DiscoveryCandidate>();

  for (const candidate of shortlist) {
    try {
      const levels =
        await analyzeDiscoveryLevels({
          symbol: candidate.symbol,
        });

      enrichedBySymbol.set(
        candidate.symbol,
        enrichCandidateWithLevels(
          candidate,
          levels,
        ),
      );
    } catch (error) {
      console.warn(
        `Level analysis unavailable for ${candidate.symbol}:`,
        error,
      );

      enrichedBySymbol.set(
        candidate.symbol,
        candidate,
      );
    }

    /*
     * Be polite to the daily candle provider.
     * Cached requests will still return quickly.
     */
    await sleep(750);
  }

  /*
   * Apply chase penalties to candidates that were
   * not selected for full support/resistance analysis.
   */
  return candidates.map((candidate) => {
    const enriched =
      enrichedBySymbol.get(candidate.symbol);

    if (enriched) {
      return enriched;
    }

    const penalty =
      getChasePenalty(
        candidate.percentChange,
      );

    if (penalty.points === 0) {
      return candidate;
    }

    return {
      ...candidate,

      score: clamp(
        candidate.score +
          penalty.points,
        0,
        100,
      ),

      reasons: [
        ...(penalty.reason
          ? [penalty.reason]
          : []),
        ...candidate.reasons,
      ],
    };
  });
}

async function mapWithConcurrency<T, R>(
  items: T[],
  concurrency: number,
  worker: (
    item: T,
    index: number,
  ) => Promise<R>,
): Promise<R[]> {
  const results =
    new Array<R>(items.length);

  let nextIndex = 0;

  async function runWorker(): Promise<void> {
    while (true) {
      const currentIndex =
        nextIndex;

      nextIndex += 1;

      if (
        currentIndex >=
        items.length
      ) {
        return;
      }

      results[currentIndex] =
        await worker(
          items[currentIndex],
          currentIndex,
        );
    }
  }

  const workerCount =
    Math.min(
      Math.max(1, concurrency),
      Math.max(1, items.length),
    );

  await Promise.all(
    Array.from(
      {
        length:
          workerCount,
      },
      () => runWorker(),
    ),
  );

  return results;
}

function finalizeDiscoveryResult(input: {
  candidates: DiscoveryCandidate[];
  failures: Array<{
    symbol: string;
    error: string;
  }>;
  scanned: number;
  minimumScore: number;
  startedAtDate: Date;
  startedAt: string;
  source:
    | "tradingview"
    | "optionpilot-fallback";
}): DiscoveryScanResult {
  const candidates =
    [...input.candidates].sort(
      (first, second) =>
        second.score -
        first.score,
    );

  const qualified =
    candidates.filter(
      (candidate) =>
        candidate.score >=
        input.minimumScore,
    );

  const completedAtDate =
    new Date();

  return {
    scanned:
      input.scanned,

    qualified:
      qualified.length,

    failed:
      input.failures.length,

    startedAt:
      input.startedAt,

    completedAt:
      completedAtDate.toISOString(),

    durationMs:
      completedAtDate.getTime() -
      input.startedAtDate.getTime(),

    candidates,

    topOpportunities:
      qualified.slice(0, 20),

    topGainers:
      [...candidates]
        .sort(
          (first, second) =>
            second.percentChange -
            first.percentChange,
        )
        .slice(0, 20),

    topLosers:
      [...candidates]
        .sort(
          (first, second) =>
            first.percentChange -
            second.percentChange,
        )
        .slice(0, 20),

    relativeVolume:
      [...candidates]
        .sort(
          (first, second) =>
            second.relativeVolume -
            first.relativeVolume,
        )
        .slice(0, 20),

    failures:
      input.failures,

    source:
      input.source,
  };
}

async function scanOptionPilotFallback(input: {
  category?: UniverseCategory;
  limit: number;
  concurrency: number;
  minimumScore: number;
  startedAtDate: Date;
  startedAt: string;
}): Promise<DiscoveryScanResult> {
  const symbols =
    input.category
      ? getUniverseSymbols(
          input.category,
        )
      : getDiscoveryUniverse(
          input.limit,
        );

  const selectedSymbols =
    symbols.slice(
      0,
      Math.max(
        1,
        input.limit,
      ),
    );

  const failures: Array<{
    symbol: string;
    error: string;
  }> = [];

  const scanResults =
    await mapWithConcurrency(
      selectedSymbols,
      input.concurrency,

      async (
        symbol,
      ): Promise<
        DiscoveryCandidate | null
      > => {
        try {
          const quote =
            await getMassiveQuote({
              symbol,
              forceRefresh: false,
            });

          return toCandidate(
            quote,
          );
        } catch (error) {
          failures.push({
            symbol,

            error:
              error instanceof Error
                ? error.message
                : "Unknown discovery scan error.",
          });

          return null;
        }
      },
    );

  const candidates =
    scanResults.filter(
      (
        candidate,
      ): candidate is DiscoveryCandidate =>
        candidate !== null,
    );

  return finalizeDiscoveryResult({
    candidates,

    failures,

    scanned:
      selectedSymbols.length,

    minimumScore:
      input.minimumScore,

    startedAtDate:
      input.startedAtDate,

    startedAt:
      input.startedAt,

    source:
      "optionpilot-fallback",
  });
}

export async function scanDiscoveryUniverse(
  options: ScanOptions = {},
): Promise<DiscoveryScanResult> {
  const {
    category,

    limit = 50,

    concurrency = 1,

    minimumScore = 45,
  } = options;

  const startedAtDate =
    new Date();

  const startedAt =
    startedAtDate.toISOString();

  /*
   * CATEGORY MODE
   *
   * Keep your existing OptionPilot
   * hand-built sector/category universe.
   */
  if (category) {
    return scanOptionPilotFallback({
      category,

      limit,

      concurrency,

      minimumScore,

      startedAtDate,

      startedAt,
    });
  }

  /*
   * DEFAULT MARKET DISCOVERY
   *
   * TradingView does the broad market scan
   * in one request.
   *
   * This avoids making dozens of Massive
   * stock quote requests just to discover
   * which symbols matter.
   */
  try {
    const tradingViewCandidates =
      await getTradingViewCandidates(
        limit,
      );

    if (
      tradingViewCandidates.length ===
      0
    ) {
      throw new Error(
        "TradingView returned no qualifying candidates.",
      );
    }

    const baseCandidates =
      tradingViewCandidates.map(
        tradingViewToCandidate,
      );

    const candidates =
      await enrichTradingViewLevels(
        baseCandidates,
      );

    return finalizeDiscoveryResult({
      candidates,

      failures: [],

      scanned:
        candidates.length,

      minimumScore,

      startedAtDate,

      startedAt,

      source:
        "tradingview",
    });
  } catch (error) {
    console.warn(
      "TradingView Discovery unavailable. Using OptionPilot fallback.",
      error,
    );

    /*
     * TradingView is unofficial/free.
     * It must never become a single point
     * of failure for OptionPilot.
     */
    return scanOptionPilotFallback({
      limit:

        Math.min(
          limit,
          20,
        ),

      concurrency,

      minimumScore,

      startedAtDate,

      startedAt,
    });
  }
}
